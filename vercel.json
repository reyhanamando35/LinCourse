{
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(favicon\\.ico|robots\\.txt|[^/]+\\.(?:png|jpe?g|webp|svg|gif|ico))$",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "crons": [
    {
      "path": "/up-db",
      "schedule": "0 3 * * *"
    }
  ]
}
